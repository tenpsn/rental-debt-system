# ---------- Server ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rental_debt
DB_POOL_MAX=10

# ---------- ความปลอดภัย ----------
# ต้องตั้งค่าสุ่มเอง อย่างน้อย 32 ตัวอักษร ถ้าเว้นว่างหรือใช้ค่าตัวอย่าง เซิร์ฟเวอร์จะไม่ยอมเปิด
# สร้างค่าสุ่มด้วยคำสั่ง node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
DEFAULT_PASSWORD=ChangeMe123!

# ---------- ไฟล์แนบ / log ----------
UPLOAD_DIR=./uploads
LOG_DIR=./logs
MAX_UPLOAD_MB=10

# ---------- CORS (ระบุ domain ของ frontend เมื่อใช้งานจริง) ----------
CORS_ORIGIN=*

# ---------- Proxy ----------
# ถ้ามี Nginx อยู่หน้า API บนเครื่องเดียวกันให้ตั้งเป็น loopback ถ้าไม่มีให้เว้นว่าง
TRUST_PROXY=
