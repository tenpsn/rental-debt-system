# ---------- Server ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rental_debt
DB_POOL_MAX=10

# ---------- ความปลอดภัย ----------
# ต้องเปลี่ยนก่อนใช้งานจริง (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
DEFAULT_PASSWORD=ChangeMe123!

# ---------- ไฟล์แนบ / log ----------
UPLOAD_DIR=./uploads
LOG_DIR=./logs
MAX_UPLOAD_MB=10

# ---------- CORS (ระบุ domain ของ frontend เมื่อใช้งานจริง) ----------
CORS_ORIGIN=*
